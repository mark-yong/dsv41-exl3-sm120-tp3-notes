# Copy to .env next to docker-compose.yml. Never commit the real key.
IMAGE=dsv41f-tempo-sm120-tp3:amd64
VLLM_API_KEY_DSV41=change-me

# The publish port binds 127.0.0.1 by default. Expose on your LAN by
# setting BIND_ADDR=0.0.0.0 (the server is API-key protected either way).
#BIND_ADDR=0.0.0.0

# Host path to the TP3 hardlink tree made by tools/prep-tp3-config.sh
MODEL_HOST_PATH=/models/safetensors/DeepSeek-V4.1-Flash-EXL3-3.5bpw-Pollard-TP3

# Optional host cache overrides
#HF_CACHE_HOST_PATH=~/.cache/huggingface
#CACHE_HOST_PATH=~/.cache/vllm-dsv41

# The compose defaults reproduce P4 (32k / 4 GiB KV / seqs 4 / batched 4096 /
# util 0.75 / Engram DDR). Override any of these to walk the ladder:
#MAX_MODEL_LEN=32768
#KV_MEM=4294967296
#UTIL=0.75
#MAX_NUM_SEQS=4
#MAX_BATCHED=4096
#DSV41_ENGRAM_DISK=0
